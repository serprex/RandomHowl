<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local.props holds this machine's game paths; build.sh writes it. -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RandomHowl</AssemblyName>
    <RootNamespace>RandomHowl</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">$(DEATH_HOWL_DATA)</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)/../BepInEx</BepInExDir>
  </PropertyGroup>

  <!-- BepInEx as installed in the game folder, and the game's own Unity
       assemblies, so the versions always match what will load this. -->
  <ItemGroup Condition="'$(NuGetRefs)' != 'true'">
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)/Managed/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)/Managed/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)/Managed/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)/Managed/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)/Managed/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Build without the game (CI): -p:NuGetRefs=true pulls references from
       NuGet instead. Unity modules match the game's Unity 2022.3.62.
       No UnityEngine.UI package exists for 2022, so that one comes from
       the stub in unitystub/. -->
  <ItemGroup Condition="'$(NuGetRefs)' == 'true'">
    <PackageReference Include="BepInEx.Core" Version="5.4.21" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
    <ProjectReference Include="../unitystub/UnityEngine.UI.csproj" Private="false" />
  </ItemGroup>

  <Target Name="CheckPaths" BeforeTargets="BeforeBuild" Condition="'$(NuGetRefs)' != 'true'">
    <Error Condition="!Exists('$(GameDir)/Managed/UnityEngine.dll')"
           Text="no game at '$(GameDir)' — build with -p:GameDir=... or set DEATH_HOWL_DATA" />
    <Error Condition="!Exists('$(BepInExDir)/core/BepInEx.dll')"
           Text="no BepInEx at '$(BepInExDir)' — install it in the game folder first" />
  </Target>

  <!-- Drop the plugin straight into BepInEx. -->
  <Target Name="Install" AfterTargets="Build" Condition="'$(PluginDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <Message Importance="high" Text="installed to $(PluginDir)" />
  </Target>

</Project>
